# =============================================================================
# Bot startup settings - only what the bot needs before its web dashboard
# is up. Everything else (channels, roles, realm, WarcraftLogs/Blizzard API
# keys, features) is set in the dashboard's setup guide after the first
# start, and stored in the bot's database.
# =============================================================================

# Discord bot token: https://discord.com/developers/applications
# -> your application -> Bot -> Reset Token.
DISCORD_TOKEN=

# Same application -> OAuth2 -> Client Secret. Lets people log in to the
# dashboard with Discord. Also add <WEB_BASE_URL>/auth/callback under
# OAuth2 -> Redirects there.
DISCORD_CLIENT_SECRET=

# The address you open the dashboard at. Over an SSH tunnel:
# http://localhost:8081 - behind a reverse proxy: https://dashboard.example.com
WEB_BASE_URL=http://localhost:8081

# Your Discord user ID (Discord settings -> Advanced -> Developer Mode on,
# then right-click your name -> Copy User ID). Comma-separated for more.
# These people can always log in and restart the bot - needed for the
# first setup, before a moderator role is chosen. The server owner always
# has this access too.
WEB_ADMIN_USER_IDS=


# =============================================================================
# Server/hosting options - the Docker setup in deploy/ sets these itself
# =============================================================================

# Run the web dashboard (default: off, for setups that don't use it).
# WEB_DASHBOARD_ENABLED=true

# Where the dashboard listens. Keep 127.0.0.1 unless something in front of
# it needs more (the Docker setup uses 0.0.0.0 inside the container).
# Avoid 8080 - AMP's own panel usually uses it.
# WEB_HOST=127.0.0.1
# WEB_PORT=8081

# Show a "Restart" button in the dashboard (admins only). Only enable this
# when something starts the bot again after it stops (Docker's restart
# policy, systemd Restart=always, AMP's auto-restart) - otherwise a
# restart from the dashboard just stops the bot.
# WEB_RESTART_ENABLED=true

# "sqlite" (one crusader.db database, recommended) or "json" (the original
# one-file-per-feature storage, the default for existing installs).
# Switching to sqlite imports the JSON files automatically and leaves them
# as a backup - see storage.py / db_tools.py.
# STORAGE_BACKEND=sqlite
# BOT_DB_PATH=crusader.db

# Optional badge next to the dashboard's logo, e.g. "test".
# WEB_ENVIRONMENT=

# Only needed if the bot is in more than one Discord server: which one to
# use. With one server it's detected automatically.
# DISCORD_GUILD_ID=


# =============================================================================
# Older setups only
# =============================================================================
# Setups from before the dashboard configured channel/role IDs, the realm
# and API keys here (MOD_ROLE_ID, REVIEW_CHANNEL_ID, SERVER_SLUG,
# WCL_CLIENT_ID, WCL_CLIENT_SECRET, BLIZZARD_CLIENT_ID, ...). Those still
# work and show up in the dashboard as "From .env" - but new installs
# should leave them out and use the dashboard instead.
