# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-api-key-here

# WarcraftLogs API client credentials from https://www.warcraftlogs.com/api/clients/
# (Create a new client, no redirect URI needed since we use client_credentials flow)
WCL_CLIENT_ID=wcl-client-id-here
WCL_CLIENT_SECRET=wcl-secret-here

# Discord channel ID where applications get posted for mod review
# In Discord's client settings enable 'Developer Mode'
# Right-click on a channel and 'Copy Channel ID'
REVIEW_CHANNEL_ID=<1234567890>

# Discord channel ID where new members apply (used to auto-post and pin a
# short "how to apply" explainer). Optional - leave blank to skip this.
GEAR_CHECK_CHANNEL_ID=1234567890

# Discord channel ID where announcement drafts get posted for tweaking
# before publishing (see cogs/announcements.py). Required for /announce.
ANNOUNCEMENT_SANDBOX_CHANNEL_ID=1234567890

# Discord role ID to assign on approval (your "Fresh" role)
FRESH_ROLE_ID=1234567890

# Discord role ID for moderators allowed to approve/deny
# (Anyone with the "Manage Roles" permission can also approve/deny)
MOD_ROLE_ID=1234567890

# Your guild's realm slug as WarcraftLogs sees it, e.g. "living-flame"
# Find this by looking at a character's URL on fresh.warcraftlogs.com:
# https://fresh.warcraftlogs.com/character/us/<THIS PART>/CharacterName
SERVER_SLUG=spineshatter

# Region code: us, eu, kr, tw, cn
SERVER_REGION=eu

# Discord FORUM channel ID where /raidsummary posts each raid's recap as a
# new thread. Create the tier/clear-status tags mentioned in config.py's
# CLEAR_STATUS_TAG_NAMES (and one per tier name) in this channel's settings
# first, so the bot can auto-apply them.
RAID_SUMMARY_FORUM_CHANNEL_ID=1234567890

# Your guild's exact name as WarcraftLogs sees it - optional, only used to
# show the "guild rank" section of /raidsummary (how your kills compare to
# other guilds on the server/region). Leave blank to skip that section.
GUILD_NAME=Your Guild Name

# Discord channel ID where your WCL-report-posting webhook/app (e.g.
# "Crusader's Logs") automatically announces new reports. Optional - when
# set, /raidsummary offers a dropdown of recent reports from this channel
# (labeled by their report title) instead of requiring a pasted link.
# Leave blank to skip straight to pasting a link in the modal.
#
# As of cogs/raid_logs.py, this channel is meant to be HIDDEN from members
# (View Channel denied for @everyone, kept for the bot's own role) - the bot
# reads it, reposts a cleaned-up version with tagging buttons to
# RAID_LOGS_REPOST_CHANNEL_ID below, and /raidsummary's picker prefers that
# repost channel's structured data when it's configured. See README section
# 11.
RAID_LOGS_CHANNEL_ID=1338096589457199124

# Discord channel ID the bot posts its own cleaned-up, tag-able repost of
# each new #logs entry to (see cogs/raid_logs.py). Optional - leave blank to
# disable the tagging/auto-summarize workflow entirely (RAID_LOGS_CHANNEL_ID
# above still works standalone for /raidsummary's picker either way).
RAID_LOGS_REPOST_CHANNEL_ID=1542628452774060072

# Discord channel ID for the pinned attendance-check messages (log list,
# roster, overview) - see cogs/attendance.py. Required for /checkattendance.
ATTENDANCE_CHANNEL_ID=1234567890

# Discord channel ID for your general moderator chat. Optional - when set,
# every Attendance Overview refresh that has a real acting user/label
# (the Refresh button, /checkattendance run, or cogs/raid_logs.py's
# Summarize automation - never the silent startup reconciliation pass)
# also mirrors the overview here, on top of the pinned post in
# ATTENDANCE_CHANNEL_ID, since that channel is easy to miss unless a mod
# happens to already be looking at it. Leave blank to skip this.
MODERATOR_CHANNEL_ID=1234567890
