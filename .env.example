# =============================================================================
# REQUIRED - the bot won't start without these
# =============================================================================

# Discord bot token from https://discord.com/developers/applications
# (your application -> Bot -> Reset Token)
DISCORD_TOKEN=your-bot-token-here

# WarcraftLogs API client from https://www.warcraftlogs.com/api/clients/
# (create a client, no redirect URI needed)
WCL_CLIENT_ID=wcl-client-id-here
WCL_CLIENT_SECRET=wcl-secret-here


# =============================================================================
# WEB DASHBOARD - fill these in to use it
# =============================================================================

# Turns the dashboard on (also possible via config/deployment_local.py).
WEB_DASHBOARD_ENABLED=false

# Developer Portal -> your application -> OAuth2 -> Client Secret. Also add
# <WEB_BASE_URL>/auth/callback under OAuth2 -> Redirects there.
DISCORD_CLIENT_SECRET=

# The address you open the dashboard at. Testing over an SSH tunnel:
# http://localhost:8081 - live behind a reverse proxy: https://dashboard.example.com
WEB_BASE_URL=http://localhost:8081

# Your Discord user ID (Developer Mode on -> right-click yourself -> Copy
# User ID). Comma-separated for several. These people always get in - you
# need this to do the first setup before a moderator role is configured
# (the server owner always gets in too).
WEB_ADMIN_USER_IDS=

# Where the dashboard listens. Keep 127.0.0.1 (only reachable from the
# server itself / through an SSH tunnel or reverse proxy). Avoid 8080 -
# AMP's own panel usually uses it. (The Docker setup sets these itself.)
WEB_HOST=127.0.0.1
WEB_PORT=8081

# Optional label shown as a badge next to the logo, e.g. "test".
WEB_ENVIRONMENT=


# =============================================================================
# OPTIONAL
# =============================================================================

# "json" (default: one file per feature) or "sqlite" (one crusader.db
# database; imports the JSON files automatically the first time and leaves
# them as a backup - see storage.py / db_tools.py). The dashboard needs a
# database either way; sqlite is recommended for new setups.
STORAGE_BACKEND=json
# BOT_DB_PATH=crusader.db

# The Discord server's ID. Leave empty when the bot is only in one server
# (it's detected automatically); set it for instant slash-command updates
# instead of Discord's up-to-an-hour global sync.
DISCORD_GUILD_ID=

# Blizzard API client (https://develop.battle.net/access/clients) - optional,
# preferred over Wowhead for item icons/names when set.
# BLIZZARD_CLIENT_ID=
# BLIZZARD_CLIENT_SECRET=


# =============================================================================
# CHANNELS, ROLES AND REALM - set these in the web dashboard instead
# =============================================================================
# Settings -> "Discord server" in the dashboard edits all of these with
# dropdowns. Anything you set here is only used as the starting value
# (that's how a bot set up before the dashboard keeps working unchanged).
# Without the dashboard, set them here: enable Developer Mode in Discord,
# then right-click a channel/role -> Copy ID.

# MOD_ROLE_ID=                      moderator role (Manage Roles also counts)
# FRESH_ROLE_ID=                    role given to approved applicants
# REVIEW_CHANNEL_ID=                where applications are posted for review
# GEAR_CHECK_CHANNEL_ID=            where members apply (bot pins an explainer)
# ANNOUNCEMENT_SANDBOX_CHANNEL_ID=  mod-only channel for announcement drafts
# ATTENDANCE_CHANNEL_ID=            pinned attendance messages
# MODERATOR_CHANNEL_ID=             mod chat; attendance overview is mirrored here
# RAID_SUMMARY_FORUM_CHANNEL_ID=    FORUM channel for raid summaries
# RAID_LOGS_CHANNEL_ID=             where your WCL webhook posts new reports
# RAID_LOGS_REPOST_CHANNEL_ID=      where the bot reposts them with tag buttons
# SERVER_SLUG=                      realm as in fresh.warcraftlogs.com/character/eu/<THIS>/Name
# SERVER_REGION=                    us, eu, kr, tw or cn
# GUILD_NAME=                       guild name on WarcraftLogs (guild-rank section)
